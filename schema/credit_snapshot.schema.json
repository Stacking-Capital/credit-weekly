{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://credit-weekly.local/schema/credit_snapshot.v1.json",
  "title": "CreditSnapshot",
  "description": "Normalized, PII-minimized weekly 3-bureau credit report snapshot.",
  "type": "object",
  "required": ["schema_version", "snapshot_id", "captured_at", "bureaus", "health_summary"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "snapshot_id": { "type": "string" },
    "week_label": { "type": "string", "description": "ISO week label, e.g. 2026-W47" },
    "captured_at": { "type": "string", "format": "date-time" },
    "is_example_data": { "type": "boolean", "default": false },
    "bureaus": {
      "type": "object",
      "properties": {
        "equifax": { "$ref": "#/$defs/bureau_report" },
        "experian": { "$ref": "#/$defs/bureau_report" },
        "transunion": { "$ref": "#/$defs/bureau_report" }
      },
      "additionalProperties": false
    },
    "health_summary": {
      "type": "object",
      "required": [
        "bureaus_present",
        "total_accounts",
        "open_accounts",
        "revolving_balance_cents",
        "revolving_limit_cents",
        "utilization_pct",
        "adverse_accounts",
        "collections_count",
        "hard_inquiries_24m",
        "public_records_count",
        "on_time_history_pct"
      ],
      "properties": {
        "bureaus_present": { "type": "array", "items": { "type": "string" } },
        "total_accounts": { "type": "integer", "minimum": 0 },
        "open_accounts": { "type": "integer", "minimum": 0 },
        "revolving_balance_cents": { "type": "integer", "minimum": 0 },
        "revolving_limit_cents": { "type": "integer", "minimum": 0 },
        "utilization_pct": { "type": "number", "minimum": 0 },
        "adverse_accounts": { "type": "integer", "minimum": 0 },
        "collections_count": { "type": "integer", "minimum": 0 },
        "hard_inquiries_24m": { "type": "integer", "minimum": 0 },
        "public_records_count": { "type": "integer", "minimum": 0 },
        "on_time_history_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "credit_health_index": { "type": "integer", "minimum": 0, "maximum": 100, "description": "0-100 Credit-Health Index computed from report facts. NOT a FICO score." },
        "credit_health_band": { "type": "string", "description": "One-word band for the Credit-Health Index (not a FICO band)." }
      }
    }
  },
  "$defs": {
    "bureau_report": {
      "type": "object",
      "required": ["bureau", "source", "personal_info", "accounts", "collections", "inquiries", "public_records", "warnings"],
      "properties": {
        "bureau": { "type": "string", "enum": ["equifax", "experian", "transunion"] },
        "source": {
          "type": "object",
          "required": ["origin", "parser", "report_date", "confidence"],
          "properties": {
            "origin": { "type": "string" },
            "parser": { "type": "string" },
            "file_number_masked": { "type": "string" },
            "report_date": { "type": "string" },
            "confidence": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "personal_info": {
          "type": "object",
          "properties": {
            "names": { "type": "array", "items": { "type": "string" } },
            "ssn_last4": { "type": "string", "pattern": "^(\\d{4})?$" },
            "dob_year": { "type": "string" },
            "addresses": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": { "type": "string" },
                  "kind": { "type": "string" },
                  "reported": { "type": "string" }
                }
              }
            },
            "employers": { "type": "array", "items": { "type": "string" } }
          }
        },
        "accounts": {
          "type": "array",
          "items": { "$ref": "#/$defs/account" }
        },
        "collections": {
          "type": "array",
          "items": { "$ref": "#/$defs/account" }
        },
        "inquiries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "creditor", "date", "kind"],
            "properties": {
              "id": { "type": "string" },
              "creditor": { "type": "string" },
              "date": { "type": "string" },
              "kind": { "type": "string", "enum": ["hard", "soft", "promotional", "account_review"] },
              "permissible_purpose": { "type": "string" }
            }
          }
        },
        "public_records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "filed_date"],
            "properties": {
              "id": { "type": "string" },
              "kind": { "type": "string" },
              "filed_date": { "type": "string" },
              "status": { "type": "string" },
              "reference_masked": { "type": "string" },
              "amount_cents": { "type": ["integer", "null"] }
            }
          }
        },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "account": {
      "type": "object",
      "required": ["id", "creditor", "account_number_masked", "kind", "status"],
      "properties": {
        "id": { "type": "string" },
        "creditor": { "type": "string" },
        "account_number_masked": { "type": "string" },
        "kind": { "type": "string", "enum": ["revolving", "installment", "mortgage", "open", "collection", "other"] },
        "account_type": { "type": "string" },
        "loan_type": { "type": "string" },
        "responsibility": { "type": "string" },
        "status": { "type": "string" },
        "is_open": { "type": "boolean" },
        "is_adverse": { "type": "boolean" },
        "balance_cents": { "type": ["integer", "null"] },
        "credit_limit_cents": { "type": ["integer", "null"] },
        "high_balance_cents": { "type": ["integer", "null"] },
        "past_due_cents": { "type": ["integer", "null"] },
        "monthly_payment_cents": { "type": ["integer", "null"] },
        "opened": { "type": "string" },
        "closed": { "type": "string" },
        "updated": { "type": "string" },
        "last_payment": { "type": "string" },
        "dofd": { "type": "string" },
        "original_creditor": { "type": "string" },
        "remarks": { "type": "array", "items": { "type": "string" } },
        "payment_history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["month", "rating"],
            "properties": {
              "month": { "type": "string" },
              "rating": { "type": "string" }
            }
          }
        },
        "confidence": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
